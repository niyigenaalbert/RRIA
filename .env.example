# =============================================================================
# Names only: values are not committed. GMAIL_APP_PASSWORD is bound to the
# managed deployment as a workspace secret in Mistral Studio (Settings >
# Secrets), never written here.
# =============================================================================
GMAIL_APP_PASSWORD=
GMAIL_FROM_USER=
BRIEF_RECIPIENT_EMAIL=
# Optional: model override for research + drafting (default mistral-small-latest, free-tier safe)
MISTRAL_MODEL=
